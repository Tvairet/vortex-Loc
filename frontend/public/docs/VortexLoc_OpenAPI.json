{
  "openapi": "3.0.3",
  "info": {
    "title": "Vortex’Loc — API de réservation",
    "version": "1.0",
    "description": "Documentation du parcours client. Les écritures exigent l’origine autorisée et un jeton lié à la session. Après connexion, le frontend redemande le jeton. Les exemples sont fictifs."
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "paths": {
    "/vehicles": {
      "get": {
        "tags": [
          "Flotte"
        ],
        "summary": "Consulter la flotte",
        "responses": {
          "200": {
            "description": "Succès",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "integer"
                      },
                      "brand": {
                        "type": "string"
                      },
                      "model": {
                        "type": "string"
                      },
                      "price_per_day": {
                        "oneOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "string"
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Ressource introuvable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erreur serveur",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/vehicles/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "get": {
        "tags": [
          "Flotte"
        ],
        "summary": "Lire une fiche véhicule",
        "responses": {
          "200": {
            "description": "Succès",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer"
                    },
                    "brand": {
                      "type": "string"
                    },
                    "model": {
                      "type": "string"
                    },
                    "price_per_day": {
                      "oneOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Saisie ou règle métier invalide",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Ressource introuvable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erreur serveur",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/csrf": {
      "get": {
        "tags": [
          "Session"
        ],
        "summary": "Obtenir le jeton CSRF",
        "responses": {
          "200": {
            "description": "Succès",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "csrf_token": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erreur serveur",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Session"
        ],
        "summary": "Ouvrir une session",
        "responses": {
          "200": {
            "description": "Succès",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "user": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Saisie ou règle métier invalide",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentification requise ou identifiants incorrects",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Origine ou jeton CSRF refusé",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erreur serveur",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "format": "password"
                  }
                },
                "required": [
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "security": [
          {
            "csrf": []
          }
        ]
      }
    },
    "/reservations": {
      "post": {
        "tags": [
          "Réservations"
        ],
        "summary": "Créer une demande",
        "responses": {
          "201": {
            "description": "Succès",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "reservation": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer"
                        },
                        "vehicle_id": {
                          "type": "integer"
                        },
                        "start_date": {
                          "type": "string",
                          "format": "date"
                        },
                        "end_date": {
                          "type": "string",
                          "format": "date"
                        },
                        "number_of_days": {
                          "type": "integer"
                        },
                        "included_km": {
                          "type": "integer"
                        },
                        "extra_km_rate": {
                          "type": "number"
                        },
                        "vehicle_subtotal": {
                          "type": "number"
                        },
                        "options_subtotal": {
                          "type": "number"
                        },
                        "total_price": {
                          "type": "number"
                        },
                        "status": {
                          "type": "string"
                        },
                        "options": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Saisie ou règle métier invalide",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentification requise ou identifiants incorrects",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Origine ou jeton CSRF refusé",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erreur serveur",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "vehicle_id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "start_date": {
                    "type": "string",
                    "format": "date"
                  },
                  "end_date": {
                    "type": "string",
                    "format": "date"
                  },
                  "pickup_location": {
                    "type": "string",
                    "maxLength": 150
                  },
                  "options": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "enum": [
                            "family_pack",
                            "escape_pack",
                            "additional_driver"
                          ]
                        },
                        "variant": {
                          "type": "string",
                          "enum": [
                            "baby_seat",
                            "child_seat",
                            "booster_seat"
                          ]
                        }
                      }
                    }
                  }
                },
                "required": [
                  "vehicle_id",
                  "start_date",
                  "end_date",
                  "pickup_location"
                ]
              },
              "example": {
                "vehicle_id": 1,
                "start_date": "2026-12-10",
                "end_date": "2026-12-13",
                "pickup_location": "Paris Gare de Lyon",
                "options": []
              }
            }
          }
        },
        "security": [
          {
            "session": [],
            "csrf": []
          }
        ],
        "description": "La demande exige une session client et un jeton CSRF. Le retour doit suivre le départ. Le serveur vérifie la disponibilité puis calcule le montant. Exemple tiré de la réservation de démonstration du dossier."
      }
    },
